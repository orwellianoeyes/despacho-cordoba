<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leo.buzon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/leonelbur/despacho-cordoba/escuchar.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/leonelbur/despacho-cordoba</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Sin esto la salida a archivo sale en bloques y el log llega tarde. -->
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Arranca al cargarse y se reinicia si muere. Al arrancar, buzon.py
       destraba solo las corridas que hubieran quedado a medias. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/leonelbur/Library/Logs/buzon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/leonelbur/Library/Logs/buzon.log</string>
</dict>
</plist>
