# Claves del Despacho Diario.
# Copiar a .env y completar. El .env NUNCA se sube al repo (está en .gitignore).
# Guardá una copia de los valores reales en tu gestor de contraseñas:
# si se pierde la Mac, esto es lo único del sistema que no está en GitHub.

# --- Obligatoria ---
# console.anthropic.com → Claves de API
ANTHROPIC_API_KEY=

# --- Avisos por Telegram (opcionales, pero es como te enterás) ---
# Token que devuelve @BotFather (se recupera con /token si lo perdés)
TELEGRAM_BOT_TOKEN=
# Tu chat_id: api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# --- Link de la app que se incluye en los avisos (opcional) ---
APP_URL=
# El panel privado en Vercel. Va en el aviso de Telegram junto al anterior:
# uno es la lectura rápida, el otro es donde se revisa y se despacha.
PANEL_URL=

# --- Correo (opcional; hoy sin usar) ---
# Clave de aplicación de Gmail, no la contraseña de la cuenta
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# --- Motor de última instancia (solo con --motor gemini) ---
# aistudio.google.com → API key
GEMINI_API_KEY=

# --- Supabase (proyecto despacho-cordoba, São Paulo) ---
SUPABASE_URL=https://rtawftdaofurzfcywain.supabase.co
# service_role: Dashboard → Settings → API Keys → service_role.
# Saltea RLS: es la credencial del motor que corre en la Mac.
# NUNCA en el panel, nunca en el repo, nunca en el navegador.
SUPABASE_SERVICE_KEY=
